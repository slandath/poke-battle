# Copy to .env for local dev (gitignored). Production values live as Railway Variables.
# Public proxy URLs (*.proxy.rlwy.net) need SSL. Private (*.railway.internal) do not.
# GitHub OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/github

# Postgres
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
