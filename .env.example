# Copy to .env for local dev (gitignored). Production values live as Railway private Variables.
# Local dev with private networking must use `railway run pnpm dev` (not plain `pnpm dev`).

# Postgres — Railway private (internal DNS, not reachable without `railway run` / Connect)
# Railway injects DATABASE_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32  # `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:5173  # production: https://<app>.up.railway.app

# GitHub OAuth (first provider; add others as GITHUB_* → GOOGLE_* etc.)
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
